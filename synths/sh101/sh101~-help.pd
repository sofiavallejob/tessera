#N canvas 0 50 1040 1250 12;
#X text 30 16 =^..^=   sh101~   version 1 (2026)   sofia vallejo budziszewski   iem kug graz austria;
#X text 30 46 sh-101 style monophonic synth;
#X text 30 86 one oscillator with saw pulse sub and noise into a self-oscillating 24 db ladder filter with one envelope and one lfo. mono with portamento and legato., f 110;
#X text 30 146 --- how it was made ---;
#X text 30 190 the oscillator is a band-limited saw and pulse (polyblep) with a sub oscillator that follows the pitch., f 110;
#X text 30 220 the filter is a zero-delay-feedback ladder with tanh saturation in the loop. at full resonance it sings by itself., f 110;
#X text 30 270 one adsr drives the filter and the amplifier. mono voice with a note stack so releasing a key goes back to the key still held., f 110;
#X text 30 330 --- how to use ---;
#X text 30 374 1  open the engine page below and turn dsp on, f 110;
#X text 30 404 2  play a midi keyboard or click chord on, f 110;
#X text 30 434 3  open the parameters page and move any control or open presets and step through the sounds, f 110;
#X text 30 464 4  everything is a message: see the messages page for the full list and the examples page for patches to copy, f 110;
#X text 30 524 try:  load squelch then turn legato on: overlapping notes glide without retriggering the envelope, f 110;
#X text 30 554 try:  raise res to the top and set vca to gate: the filter becomes a sine oscillator that follows the keyboard, f 110;
#X text 30 604 try:  set pwmode to lfo and move pwamt for slow pulse width movement, f 110;
#X text 30 648 --- common problems ---;
#X text 30 692 no sound: turn dsp on in the engine page and check the volume slider. the synth needs a note: click chord on or play a midi key, f 110;
#X text 30 742 nothing changes after a rebuild: pd keeps the old external in memory so close every patch and restart pd, f 110;
#X text 30 772 a note is stuck: send panic. a missing note off from a midi device is the usual cause, f 110;
#X text 30 802 unknown parameter in the console: names are exact and lowercase so send params to print them all, f 110;
#X text 30 832 a bank file is not found: save and load names are relative to the folder of this patch, f 110;
#X text 30 862 the sliders do not move when you change a preset: the object must be created with the same name as in the boxes. default name is the object name, f 110;
#X text 30 912 clicks or dropouts: raise the audio buffer in the pd audio settings or lower the voice count in the creation argument, f 110;
#X text 30 962 no pitch glide: raise glide and set legato on and then play overlapping notes, f 110;
#X text 30 1006 --- click a box to open that page ---;
#N canvas 0 50 900 1296 presets 0;
#X text 30 16 presets: factory sounds are stored as plain text and every control above is a message. click a box to load that sound, f 100;
#X text 30 66 --- factory presets ---;
#X msg 30 110 \; sh101 preset 0;
#X text 250 112 0  classic bass;
#X msg 30 164 \; sh101 preset 1;
#X text 250 166 1  square sub;
#X msg 30 218 \; sh101 preset 2;
#X text 250 220 2  squelch;
#X msg 30 272 \; sh101 preset 3;
#X text 250 274 3  pwm lead;
#X msg 30 326 \; sh101 preset 4;
#X text 250 328 4  fat saw lead;
#X msg 30 380 \; sh101 preset 5;
#X text 250 382 5  zap;
#X msg 30 434 \; sh101 preset 6;
#X text 250 436 6  pluck;
#X msg 30 488 \; sh101 preset 7;
#X text 250 490 7  resonant sweep;
#X msg 460 110 \; sh101 preset 8;
#X text 680 112 8  laser siren;
#X msg 460 164 \; sh101 preset 9;
#X text 680 166 9  noise hit;
#X msg 460 218 \; sh101 preset 10;
#X text 680 220 10  wind;
#X msg 460 272 \; sh101 preset 11;
#X text 680 274 11  hollow reed;
#X msg 460 326 \; sh101 preset 12;
#X text 680 328 12  wobble;
#X msg 460 380 \; sh101 preset 13;
#X text 680 382 13  blip;
#X msg 460 434 \; sh101 preset 14;
#X text 680 436 14  rez pad;
#X msg 460 488 \; sh101 preset 15;
#X text 680 490 15  self osc sine;
#X text 30 562 --- now playing ---;
#X symbolatom 30 606 20 0 0 0 - sh101-name - 0;
#X floatatom 230 606 4 0 0 0 - sh101-index - 0;
#X text 340 608 name and number (minus one means edited);
#X msg 30 650 \; sh101 next;
#X msg 166 650 \; sh101 prev;
#X msg 302 650 \; sh101 mutate 0.3;
#X text 30 710 next and prev step through the presets and wrap around. mutate varies the current sound by a random amount from 0 to 1, f 100;
#X text 30 760 --- morph between two sounds ---;
#X msg 30 804 \; sh101 A;
#X msg 142 804 \; sh101 B;
#X text 254 806 a and b remember the current sound;
#X text 30 866 morph;
#X obj 110 864 hsl 300 18 0 1 0 0 sh101-morph sh101-morph-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 908 load one preset and press a then load another and press b then move the morph slider. every parameter blends smoothly between the two, f 100;
#X text 30 958 --- your own user bank ---;
#X msg 30 1002 \; sh101 store mysound;
#X msg 238 1002 \; sh101 save my.bank;
#X msg 438 1002 \; sh101 load my.bank;
#X text 30 1062 store keeps the current sound after the factory presets. save writes the user bank to a text file next to this patch and load adds the sounds from a text file, f 100;
#X text 30 1112 --- presets with stash ---;
#X text 30 1156 every slider in the parameters page sends to sh101-name and listens on sh101-name-r so the stash library can store and morph whole scenes: create [stash/bank sh101] and send it a scan message for a saved copy of the parameters page. this follows the stash naming rules but has not been tested together yet, f 100;
#X restore 30 1050 pd presets;
#X text 30 1084 all sounds and morph, f 22;
#N canvas 0 50 1500 1604 parameters 0;
#X text 30 16 every control here is also a message: set name value with values from 0 to 1. switches take the step number shown under each one, f 120;
#X text 30 66 --- oscillator ---;
#X text 30 106 range  -  set range;
#X obj 30 138 hradio 18 1 0 4 sh101-range sh101-range-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 30 170 0..3 : 16 | 8 | 4 | 2 feet, f 34;
#X text 30 224 saw  -  set saw;
#X obj 30 256 hsl 190 18 0 1 0 0 sh101-saw sh101-saw-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 342 pulse  -  set pulse;
