#X text 950 224 lfo wave  -  set lfowave;
#X obj 950 256 hradio 18 1 0 3 sh101-lfowave sh101-lfowave-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 950 288 0..2 : triangle | square | random, f 34;
