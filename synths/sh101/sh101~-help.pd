#X obj 950 374 hsl 190 18 0 1 0 0 sh101-lfopitch sh101-lfopitch-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 950 460 lfo to filter  -  set lfofilt;
#X obj 950 492 hsl 190 18 0 1 0 0 sh101-lfofilt sh101-lfofilt-r empty -2 -8 0 12 -262144 -1 -1 0 1;
