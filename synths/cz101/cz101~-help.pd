#N canvas 0 50 1040 1300 12;
#X text 30 16 =^..^=   cz101~   version 1 (2026)   sofia vallejo budziszewski   iem kug graz austria;
#X text 30 46 cz-101 style phase distortion synth;
#X text 30 86 phase distortion: each of the two lines per voice is a sine whose phase is bent into saw square pulse double sine and resonant waveforms. an envelope for the distortion amount and one for amplitude plus pitch envelope and ring or noise modulation. eight voices., f 110;
#X text 30 166 --- how it was made ---;
#X text 30 210 each line reads a cosine through a bent phase (phase distortion). the distortion amount moves the bend point so the sine turns into a saw or a square., f 110;
#X text 30 260 the resonant waveforms multiply a cosine of a rising harmonic by a window. two times oversampling keeps the aliasing low., f 110;
#X text 30 310 the distortion envelope is what makes the characteristic plucks and sweeps. higher keys get less distortion if dcwkbd is up., f 110;
#X text 30 370 --- how to use ---;
#X text 30 414 1  open the engine page below and turn dsp on, f 110;
#X text 30 444 2  play a midi keyboard or click chord on, f 110;
#X text 30 474 3  open the parameters page and move any control or open presets and step through the sounds, f 110;
#X text 30 504 4  everything is a message: see the messages page for the full list and the examples page for patches to copy, f 110;
#X text 30 564 try:  load string pad and move dcw1 while holding a chord: the sine turns into a saw, f 110;
#X text 30 594 try:  try the resonance waves: the dcw knob sweeps the resonant peak up and down, f 110;
#X text 30 624 try:  set mod to ring and detune the second line: metallic and inharmonic, f 110;
#X text 30 668 --- common problems ---;
#X text 30 712 no sound: turn dsp on in the engine page and check the volume slider. the synth needs a note: click chord on or play a midi key, f 110;
#X text 30 762 nothing changes after a rebuild: pd keeps the old external in memory so close every patch and restart pd, f 110;
#X text 30 792 a note is stuck: send panic. a missing note off from a midi device is the usual cause, f 110;
#X text 30 822 unknown parameter in the console: names are exact and lowercase so send params to print them all, f 110;
#X text 30 852 a bank file is not found: save and load names are relative to the folder of this patch, f 110;
#X text 30 882 the sliders do not move when you change a preset: the object must be created with the same name as in the boxes. default name is the object name, f 110;
#X text 30 932 clicks or dropouts: raise the audio buffer in the pd audio settings or lower the voice count in the creation argument, f 110;
#X text 30 982 no change when dcw moves: the distortion envelope scales dcw so raise dcwsus or dcwdec, f 110;
#X text 30 1012 line 2 is silent: raise mix2, f 110;
#X text 30 1056 --- click a box to open that page ---;
#N canvas 0 50 900 1242 presets 0;
#X text 30 16 presets: factory sounds are stored as plain text and every control above is a message. click a box to load that sound, f 100;
#X text 30 66 --- factory presets ---;
#X msg 30 110 \; cz101 preset 0;
#X text 250 112 0  saw brass;
#X msg 30 164 \; cz101 preset 1;
#X text 250 166 1  pink pluck;
#X msg 30 218 \; cz101 preset 2;
#X text 250 220 2  cosmic bass;
#X msg 30 272 \; cz101 preset 3;
#X text 250 274 3  resonance lead;
#X msg 30 326 \; cz101 preset 4;
#X text 250 328 4  square keys;
#X msg 30 380 \; cz101 preset 5;
#X text 250 382 5  double bell;
#X msg 30 434 \; cz101 preset 6;
#X text 250 436 6  glass reso;
#X msg 460 110 \; cz101 preset 7;
#X text 680 112 7  string pad;
#X msg 460 164 \; cz101 preset 8;
#X text 680 166 8  hollow pipe;
#X msg 460 218 \; cz101 preset 9;
#X text 680 220 9  zapper;
#X msg 460 272 \; cz101 preset 10;
#X text 680 274 10  wood block;
#X msg 460 326 \; cz101 preset 11;
#X text 680 328 11  ring mod metal;
#X msg 460 380 \; cz101 preset 12;
#X text 680 382 12  noise edge;
#X msg 460 434 \; cz101 preset 13;
#X text 680 436 13  soft sine;
#X text 30 508 --- now playing ---;
#X symbolatom 30 552 20 0 0 0 - cz101-name - 0;
#X floatatom 230 552 4 0 0 0 - cz101-index - 0;
#X text 340 554 name and number (minus one means edited);
#X msg 30 596 \; cz101 next;
#X msg 166 596 \; cz101 prev;
#X msg 302 596 \; cz101 mutate 0.3;
#X text 30 656 next and prev step through the presets and wrap around. mutate varies the current sound by a random amount from 0 to 1, f 100;
#X text 30 706 --- morph between two sounds ---;
#X msg 30 750 \; cz101 A;
#X msg 142 750 \; cz101 B;
#X text 254 752 a and b remember the current sound;
#X text 30 812 morph;
#X obj 110 810 hsl 300 18 0 1 0 0 cz101-morph cz101-morph-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 854 load one preset and press a then load another and press b then move the morph slider. every parameter blends smoothly between the two, f 100;
#X text 30 904 --- your own user bank ---;
#X msg 30 948 \; cz101 store mysound;
#X msg 238 948 \; cz101 save my.bank;
#X msg 438 948 \; cz101 load my.bank;
#X text 30 1008 store keeps the current sound after the factory presets. save writes the user bank to a text file next to this patch and load adds the sounds from a text file, f 100;
#X text 30 1058 --- presets with stash ---;
#X text 30 1102 every slider in the parameters page sends to cz101-name and listens on cz101-name-r so the stash library can store and morph whole scenes: create [stash/bank cz101] and send it a scan message for a saved copy of the parameters page. this follows the stash naming rules but has not been tested together yet, f 100;
#X restore 30 1100 pd presets;
#X text 30 1134 all sounds and morph, f 22;
#N canvas 0 50 1500 1728 parameters 0;
#X text 30 16 every control here is also a message: set name value with values from 0 to 1. switches take the step number shown under each one, f 120;
#X text 30 66 --- line 1 ---;
#X text 30 106 op 1 wave  -  set wave1;
#X obj 30 138 hradio 18 1 0 8 cz101-wave1 cz101-wave1-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 30 170 0..7 : saw | square | pulse | double sine | saw pulse | resonance i | resonance ii | resonance iii, f 34;
#X text 30 264 distortion 1  -  set dcw1;
#X obj 30 296 hsl 190 18 0 1 0 0 cz101-dcw1 cz101-dcw1-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 350 66 --- line 2 ---;
#X text 350 106 op 2 wave  -  set wave2;
#X obj 350 138 hradio 18 1 0 8 cz101-wave2 cz101-wave2-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 350 170 0..7 : saw | square | pulse | double sine | saw pulse | resonance i | resonance ii | resonance iii, f 34;
#X text 350 264 distortion 2  -  set dcw2;
#X obj 350 296 hsl 190 18 0 1 0 0 cz101-dcw2 cz101-dcw2-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 350 422 detune line 2  -  set detune;
#X obj 350 454 hsl 190 18 0 1 0 0 cz101-detune cz101-detune-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 650 106 line 2 octave  -  set oct2;
#X obj 650 138 hradio 18 1 0 3 cz101-oct2 cz101-oct2-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 650 170 0..2 : one octave down | same | one octave up, f 34;
#X text 650 264 level line 2  -  set mix2;
#X obj 650 296 hsl 190 18 0 1 0 0 cz101-mix2 cz101-mix2-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 970 66 --- modulation ---;
#X text 970 106 line modulation  -  set mod;
#X obj 970 138 hradio 18 1 0 3 cz101-mod cz101-mod-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 970 170 0..2 : off | ring | noise, f 34;
#X text 970 264 dcw key follow  -  set dcwkbd;
#X obj 970 296 hsl 190 18 0 1 0 0 cz101-dcwkbd cz101-dcwkbd-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 610 --- distortion envelope ---;
#X text 30 650 dcw attack  -  set dcwatt;
#X obj 30 682 hsl 190 18 0 1 0 0 cz101-dcwatt cz101-dcwatt-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 808 dcw decay  -  set dcwdec;
#X obj 30 840 hsl 190 18 0 1 0 0 cz101-dcwdec cz101-dcwdec-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 966 dcw sustain  -  set dcwsus;
#X obj 30 998 hsl 190 18 0 1 0 0 cz101-dcwsus cz101-dcwsus-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 1124 dcw release  -  set dcwrel;
#X obj 30 1156 hsl 190 18 0 1 0 0 cz101-dcwrel cz101-dcwrel-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 350 610 --- amplitude envelope ---;
#X text 350 650 attack  -  set att;
#X obj 350 682 hsl 190 18 0 1 0 0 cz101-att cz101-att-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 350 808 decay  -  set dec;
#X obj 350 840 hsl 190 18 0 1 0 0 cz101-dec cz101-dec-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 350 966 sustain  -  set sus;
#X obj 350 998 hsl 190 18 0 1 0 0 cz101-sus cz101-sus-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 350 1124 release  -  set rel;
#X obj 350 1156 hsl 190 18 0 1 0 0 cz101-rel cz101-rel-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 670 610 --- pitch and vibrato ---;
#X text 670 650 pitch env amount  -  set pitchamt;
#X obj 670 682 hsl 190 18 0 1 0 0 cz101-pitchamt cz101-pitchamt-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 670 808 pitch env decay  -  set pitchdec;
#X obj 670 840 hsl 190 18 0 1 0 0 cz101-pitchdec cz101-pitchdec-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 670 966 vibrato rate  -  set vibrate;
#X obj 670 998 hsl 190 18 0 1 0 0 cz101-vibrate cz101-vibrate-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 970 650 vibrato depth  -  set vibdepth;
#X obj 970 682 hsl 190 18 0 1 0 0 cz101-vibdepth cz101-vibdepth-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 970 808 vibrato delay  -  set vibdelay;
#X obj 970 840 hsl 190 18 0 1 0 0 cz101-vibdelay cz101-vibdelay-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 1312 --- output ---;
#X text 30 1352 velocity  -  set vel;
#X obj 30 1384 hsl 190 18 0 1 0 0 cz101-vel cz101-vel-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 1510 volume  -  set vol;
#X obj 30 1542 hsl 190 18 0 1 0 0 cz101-vol cz101-vol-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X restore 220 1100 pd parameters;
#X text 220 1134 every control, f 22;
#N canvas 0 50 1300 1516 messages 0;
#X text 30 16 click any box to send it to the synth. the synth receives everything through its name so you can use [s cz101] from anywhere in your patch, f 110;
#X msg 30 66 \; cz101 note 60 100;
#X text 334 68 play midi note 60 at velocity 100 (velocity 0 is note off);
#X msg 30 120 \; cz101 note 60 0;
#X text 334 122 release note 60;
#X msg 30 174 \; cz101 bend 0.5;
#X text 334 176 pitch bend from -1 to 1 (size set by bendrange);
#X msg 30 228 \; cz101 bendrange 12;
#X text 334 230 bend range in semitones (default 2);
#X msg 30 282 \; cz101 mod 0.5;
#X text 334 284 mod wheel from 0 to 1 (more lfo);
#X msg 30 336 \; cz101 aftertouch 0.5;
#X text 334 338 channel pressure from 0 to 1 (opens the filter);
#X msg 30 390 \; cz101 sustain 1;
#X text 334 392 sustain pedal (1 down and 0 up);
#X msg 30 444 \; cz101 panic;
#X text 334 446 silence everything immediately;
#X msg 30 498 \; cz101 set dcw1 0.3;
#X text 334 500 set one parameter by name (see the parameters page);
#X msg 30 552 \; cz101 params;
#X text 334 554 print every parameter name to the pd window;
#X msg 30 606 \; cz101 preset 3;
#X text 334 608 load preset number 3 (counting from 0);
#X msg 30 660 \; cz101 next;
#X text 334 662 next preset (wraps around);
#X msg 30 714 \; cz101 prev;
#X text 334 716 previous preset;
#X msg 30 768 \; cz101 mutate 0.3;
#X text 334 770 random variation of the current sound from 0 to 1;
#X msg 30 822 \; cz101 A;
#X text 334 824 remember the current sound as a;
#X msg 30 876 \; cz101 B;
#X text 334 878 remember the current sound as b;
#X msg 30 930 \; cz101 morph 0.5;
#X text 334 932 blend between a and b;
#X msg 30 984 \; cz101 store mysound;
#X text 334 986 keep the current sound in the user bank after the factory presets;
#X msg 30 1038 \; cz101 save my.bank;
#X text 334 1040 write the user bank to a text file next to this patch;
#X msg 30 1092 \; cz101 load my.bank;
#X text 334 1094 add the presets from a text file to the user bank;
#X msg 30 1146 \; cz101 data 0.5;
#X text 334 1148 data inlet: any number from 0 to 1 (a sensor or a csv column) that drives mapped parameters;
#X msg 30 1200 \; cz101 datamap dcw1 0.3;
#X text 334 1202 map data to a parameter: it moves up to 0.3 either side (a negative amount inverts);
#X msg 30 1254 \; cz101 datamap clear;
#X text 334 1256 remove all data mappings (up to four at once);
#X text 30 1322 --- outlets of the object ---;
#X text 30 1366 outlet 1 audio left   outlet 2 audio right   outlet 3 preset name as a symbol   outlet 4 list with preset index and preset count, f 110;
#X text 30 1416 create it as [cz101~]  or  [cz101~ name]  or  [cz101~ name 8]   where name is the prefix used by every box and 8 is the voice count, f 110;
#X restore 410 1100 pd messages;
#X text 410 1134 clickable list, f 22;
