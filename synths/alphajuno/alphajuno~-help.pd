#X text 650 66 --- lfo ---;
#X text 650 106 lfo rate  -  set lforate;
#X obj 650 138 hsl 190 18 0 1 0 0 alphajuno-lforate alphajuno-lforate-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 650 224 lfo delay  -  set lfodelay;
#X obj 650 256 hsl 190 18 0 1 0 0 alphajuno-lfodelay alphajuno-lfodelay-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 650 342 lfo wave  -  set lfowave;
#X obj 650 374 hradio 18 1 0 3 alphajuno-lfowave alphajuno-lfowave-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 650 406 0..2 : triangle | square | random, f 34;
#X text 950 106 lfo to pitch  -  set lfopitch;
#X obj 950 138 hsl 190 18 0 1 0 0 alphajuno-lfopitch alphajuno-lfopitch-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 950 224 lfo to filter  -  set lfofilt;
#X obj 950 256 hsl 190 18 0 1 0 0 alphajuno-lfofilt alphajuno-lfofilt-r empty -2 -8 0 12 -262144 -1 -1 0 1;
