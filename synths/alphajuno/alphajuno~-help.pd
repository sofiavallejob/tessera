#N canvas 0 50 1040 1230 12;
#X text 30 16 =^..^=   alphajuno~   version 1 (2026)   sofia vallejo budziszewski   iem kug graz austria;
#X text 30 46 alpha juno style 6-voice synth;
#X text 30 86 one dco per voice with saw pulse sub and noise then a switched high-pass and a 24 db low-pass. one envelope for pitch filter and amplitude and a chorus with adjustable rate. six voices., f 110;
#X text 30 146 --- how it was made ---;
#X text 30 190 six identical voices each with a band-limited dco sub oscillator and noise into a switched high-pass and a ladder low-pass., f 110;
#X text 30 240 the real machine has a multi-stage envelope. here one adsr is routed to pitch filter and amplitude with separate amounts., f 110;
#X text 30 290 the stereo chorus has two modes and a programmable rate., f 110;
#X text 30 330 --- how to use ---;
#X text 30 374 1  open the engine page below and turn dsp on, f 110;
#X text 30 404 2  play a midi keyboard or click chord on, f 110;
#X text 30 434 3  open the parameters page and move any control or open presets and step through the sounds, f 110;
#X text 30 464 4  everything is a message: see the messages page for the full list and the examples page for patches to copy, f 110;
#X text 30 524 try:  load pwm strings and move chrate: the chorus speed is programmable, f 110;
#X text 30 554 try:  move envpitch away from the middle for a pitch sweep on every note, f 110;
#X text 30 584 try:  set lfodelay up and lfopitch a little: vibrato fades in after each key press, f 110;
#X text 30 628 --- common problems ---;
#X text 30 672 no sound: turn dsp on in the engine page and check the volume slider. the synth needs a note: click chord on or play a midi key, f 110;
#X text 30 722 nothing changes after a rebuild: pd keeps the old external in memory so close every patch and restart pd, f 110;
#X text 30 752 a note is stuck: send panic. a missing note off from a midi device is the usual cause, f 110;
#X text 30 782 unknown parameter in the console: names are exact and lowercase so send params to print them all, f 110;
#X text 30 812 a bank file is not found: save and load names are relative to the folder of this patch, f 110;
#X text 30 842 the sliders do not move when you change a preset: the object must be created with the same name as in the boxes. default name is the object name, f 110;
#X text 30 892 clicks or dropouts: raise the audio buffer in the pd audio settings or lower the voice count in the creation argument, f 110;
#X text 30 942 the filter never self-oscillates: that is on purpose because the real low-pass does not either, f 110;
#X text 30 986 --- click a box to open that page ---;
#N canvas 0 50 900 1296 presets 0;
#X text 30 16 presets: factory sounds are stored as plain text and every control above is a message. click a box to load that sound, f 100;
#X text 30 66 --- factory presets ---;
#X msg 30 110 \; alphajuno preset 0;
#X text 250 112 0  warm brass;
#X msg 30 164 \; alphajuno preset 1;
#X text 250 166 1  pwm strings;
#X msg 30 218 \; alphajuno preset 2;
#X text 250 220 2  glass pad;
#X msg 30 272 \; alphajuno preset 3;
#X text 250 274 3  bass one;
#X msg 30 326 \; alphajuno preset 4;
#X text 250 328 4  sub floor;
#X msg 30 380 \; alphajuno preset 5;
#X text 250 382 5  poly lead;
#X msg 30 434 \; alphajuno preset 6;
#X text 250 436 6  soft pluck;
#X msg 30 488 \; alphajuno preset 7;
#X text 250 490 7  sweep pad;
#X msg 460 110 \; alphajuno preset 8;
#X text 680 112 8  brass stab;
#X msg 460 164 \; alphajuno preset 9;
#X text 680 166 9  vox pad;
#X msg 460 218 \; alphajuno preset 10;
#X text 680 220 10  clav funk;
#X msg 460 272 \; alphajuno preset 11;
#X text 680 274 11  air;
#X msg 460 326 \; alphajuno preset 12;
#X text 680 328 12  pulse keys;
#X msg 460 380 \; alphajuno preset 13;
#X text 680 382 13  dream chorus;
#X msg 460 434 \; alphajuno preset 14;
#X text 680 436 14  saw stack;
#X msg 460 488 \; alphajuno preset 15;
#X text 680 490 15  harp;
#X text 30 562 --- now playing ---;
#X symbolatom 30 606 20 0 0 0 - alphajuno-name - 0;
#X floatatom 230 606 4 0 0 0 - alphajuno-index - 0;
#X text 340 608 name and number (minus one means edited);
#X msg 30 650 \; alphajuno next;
#X msg 198 650 \; alphajuno prev;
#X msg 366 650 \; alphajuno mutate 0.3;
#X text 30 710 next and prev step through the presets and wrap around. mutate varies the current sound by a random amount from 0 to 1, f 100;
#X text 30 760 --- morph between two sounds ---;
#X msg 30 804 \; alphajuno A;
#X msg 174 804 \; alphajuno B;
#X text 318 806 a and b remember the current sound;
#X text 30 866 morph;
#X obj 110 864 hsl 300 18 0 1 0 0 alphajuno-morph alphajuno-morph-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 908 load one preset and press a then load another and press b then move the morph slider. every parameter blends smoothly between the two, f 100;
#X text 30 958 --- your own user bank ---;
#X msg 30 1002 \; alphajuno store mysound;
#X msg 270 1002 \; alphajuno save my.bank;
#X msg 502 1002 \; alphajuno load my.bank;
#X text 30 1062 store keeps the current sound after the factory presets. save writes the user bank to a text file next to this patch and load adds the sounds from a text file, f 100;
#X text 30 1112 --- presets with stash ---;
#X text 30 1156 every slider in the parameters page sends to alphajuno-name and listens on alphajuno-name-r so the stash library can store and morph whole scenes: create [stash/bank alphajuno] and send it a scan message for a saved copy of the parameters page. this follows the stash naming rules but has not been tested together yet, f 100;
#X restore 30 1030 pd presets;
#X text 30 1064 all sounds and morph, f 22;
#N canvas 0 50 1500 1722 parameters 0;
#X text 30 16 every control here is also a message: set name value with values from 0 to 1. switches take the step number shown under each one, f 120;
#X text 30 66 --- dco ---;
#X text 30 106 range  -  set range;
#X obj 30 138 hradio 18 1 0 3 alphajuno-range alphajuno-range-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 30 170 0..2 : 16 | 8 | 4 feet, f 34;
#X text 30 224 saw  -  set saw;
#X obj 30 256 hsl 190 18 0 1 0 0 alphajuno-saw alphajuno-saw-r empty -2 -8 0 12 -262144 -1 -1 0 1;
