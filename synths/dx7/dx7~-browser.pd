#X symbolatom 520 412 16 0 0 0 - - d7-search 0;
#X text 660 414 search a name or a bank (type then press enter), f 40;
#X floatatom 520 482 5 0 0 0 - - d7-algof 0;
#X text 600 484 algorithm 1 to 32 and 0 for any, f 40;
#X obj 520 532 tgl 28 0 d7-favs empty empty 0 0 0 12 -262144 -1 -1 0 1;
#X text 558 538 favourites only;
#X obj 760 532 bng 28 250 50 0 d7-reset empty empty 0 0 0 12 -262144 -1 -1;
#X text 798 538 reset filters;
#X text 40 640 5  FAVOURITES AND SAVING;
#X obj 40 672 bng 28 250 50 0 d7-fav empty empty 0 0 0 12 -262144 -1 -1;
#X text 78 678 favourite on/off;
#X symbolatom 300 674 10 0 0 0 - - d7-newname 0;
