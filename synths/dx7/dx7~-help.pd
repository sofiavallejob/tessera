#N canvas 80 60 1000 1040 12;
#X text 40 20 dx7~ - polyphonic six-operator FM synthesizer (DX7 engine);
#X text 40 48 loads real DX7 SysEx banks - 32 algorithms - feedback loops - pitch EG - LFO;
#X text 40 100 load a .syx bank;
#X msg 40 130 \; dx7h load dx7_demo_bank.syx;
#X text 40 185 program number (0 to 31);
#X floatatom 40 215 5 0 31 0 - - - 0;
#X msg 40 255 \; dx7h program \$1;
#X text 360 100 play from a MIDI keyboard;
#X obj 360 130 notein;
#X obj 360 180 pack f f;
#X text 360 230 or click (velocity 0 = off);
#X msg 360 260 \; dx7h 60 100;
#X msg 520 260 \; dx7h 60 0;
#X msg 360 310 \; dx7h 64 100;
#X msg 520 310 \; dx7h 64 0;
#X msg 360 360 \; dx7h 67 100;
#X msg 520 360 \; dx7h 67 0;
#X msg 360 410 \; dx7h panic;
#X text 700 100 edit the voice (next note);
#X msg 700 130 \; dx7h set algorithm 5;
#X msg 700 170 \; dx7h op 2 coarse 14;
#X msg 700 210 \; dx7h op 2 level 85;
#X msg 700 250 \; dx7h op 1 l3 0;
#X msg 700 290 \; dx7h op 1 r3 50;
#X msg 700 330 \; dx7h set lfopmd 20;
#X msg 700 370 \; dx7h dac vintage;
#X msg 700 410 \; dx7h init;
#X obj 40 480 r dx7h;
#X obj 40 540 dx7~ 16;
#X obj 40 640 dac~;
#X obj 300 590 route program bank;
#X symbolatom 300 640 12 0 0 0 - - - 0;
#X floatatom 480 640 5 0 0 0 - - - 0;
#X floatatom 580 640 5 0 0 0 - - - 0;
#X text 300 675 patch name;
#X text 480 675 program;
#X text 580 675 bank size;
#X text 40 720 turn DSP on (Ctrl+/ or Cmd+/) - outlets: signal - program/bank info - patch name;
#X text 40 790 note <pitch> <velocity> or a list - noteoff <pitch> - bend <-1 to 1> - bendrange <semitones> - modwheel <0 to 1> - modassign <pitch 0/1> <amp 0/1> - sustain <0/1> - tune <cents> - gain <x> - panic \, f 100;
#X text 40 860 load <file> [program] - program <n> - sysex <bytes...> - init - print - name <text> - load looks next to this patch first and also takes a full path \, f 100;
#X text 40 910 set <algorithm 1-32 / feedback / oscsync / lfospeed / lfodelay / lfopmd / lfoamd / lfosync / lfowave / lfopms / transpose / pegr1-4 / pegl1-4> <value> \, f 100;
#X text 40 960 op <1-6> <r1-r4 / l1-l4 / bp / ld / rd / lc / rc / rs / ams / kvs / level / mode / coarse / fine / detune> <value> - opswitch <1-6> <0/1> - wave <1-6> <0-7> - dac <vintage/modern> \, f 100;
#X connect 5 0 6 0;
#X connect 8 0 9 0;
#X connect 8 1 9 1;
#X connect 9 0 28 0;
#X connect 27 0 28 0;
#X connect 28 0 29 0;
#X connect 28 0 29 1;
#X connect 28 1 30 0;
#X connect 28 2 31 0;
#X connect 30 0 32 0;
#X connect 30 1 33 0;
