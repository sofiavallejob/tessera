#N canvas 40 40 840 700 12;
#X text 40 20 dx7~  player;
#X text 40 46 give it a folder of .syx banks then step through the voices and play with a MIDI keyboard., f 80;
#X msg 40 100 lib scan sysex;
#X text 190 102 click once. Edit the folder name first or write a full path. It is read next to this patch., f 54;
#X msg 40 190 lib prev;
#X msg 130 190 lib next;
#X msg 220 190 lib random;
#X msg 330 190 lib fav;
#X msg 420 190 panic;
#X obj 560 250 r dx7p;
#X obj 40 330 dx7~ 16, f 40;
#X obj 40 420 dac~;
#X obj 150 420 route lib;
#X obj 150 460 unpack f f;
#X floatatom 150 510 5 0 0 0 - - - 0;
#X floatatom 230 510 5 0 0 0 - - - 0;
#X text 150 540 position;
#X text 230 540 of total;
#X symbolatom 290 420 12 0 0 0 - - - 0;
#X symbolatom 430 420 20 0 0 0 - - - 0;
#X text 290 450 voice;
#X text 430 450 bank file;
#X text 40 600 set your MIDI device in the Pd preferences. Notes and velocity and mod wheel and sustain pedal and pitch bend are wired inside [pd midi]., f 80;
#N canvas 0 50 760 560 midi 0;
#X obj 30 30 notein;
#X obj 30 80 pack f f;
#X obj 30 130 s dx7p;
#X obj 250 30 ctlin 1;
#X obj 250 80 / 127;
#X msg 250 130 modwheel \$1;
#X obj 250 180 s dx7p;
#X obj 30 260 ctlin 64;
#X obj 30 310 >= 64;
#X msg 30 360 sustain \$1;
#X obj 30 410 s dx7p;
#X obj 250 260 bendin;
#X obj 250 310 - 8192;
#X obj 250 360 / 8192;
#X msg 250 410 bend \$1;
#X obj 250 460 s dx7p;
#X connect 0 0 1 0;
#X connect 0 1 1 1;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
#X connect 13 0 14 0;
#X connect 14 0 15 0;
#X restore 700 100 pd midi;
#X connect 2 0 10 0;
#X connect 4 0 10 0;
#X connect 5 0 10 0;
#X connect 6 0 10 0;
#X connect 7 0 10 0;
#X connect 8 0 10 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 10 0 11 1;
#X connect 10 1 12 0;
#X connect 12 0 13 0;
#X connect 13 0 14 0;
#X connect 13 1 15 0;
#X connect 10 2 18 0;
#X connect 10 3 19 0;
