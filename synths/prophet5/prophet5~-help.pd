#N canvas 0 50 1040 1320 12;
#X text 30 16 =^..^=   prophet5~   version 1 (2026)   sofia vallejo budziszewski   iem kug graz austria;
#X text 30 46 prophet-5 style 5-voice polysynth;
#X text 30 86 five voices with two oscillators each. oscillator a has saw and pulse with pulse width and oscillator b has saw triangle and pulse with sync and a low-frequency mode. poly-mod sends the filter envelope and oscillator b to pitch pulse width and filter. a 24 db low-pass two adsr envelopes an lfo and analogue-style drift., f 110;
#X text 30 186 --- how it was made ---;
#X text 30 230 each voice is two oscillators (band-limited) through a ladder low-pass with a filter envelope and an amplifier envelope., f 110;
#X text 30 280 oscillator b is computed first. it is the sync master and with the filter envelope it is the poly-mod source., f 110;
#X text 30 330 every voice has its own slow random drift and its own lfo so chords are never perfectly still., f 110;
#X text 30 370 --- how to use ---;
#X text 30 414 1  open the engine page below and turn dsp on, f 110;
#X text 30 444 2  play a midi keyboard or click chord on, f 110;
#X text 30 474 3  open the parameters page and move any control or open presets and step through the sounds, f 110;
#X text 30 504 4  everything is a message: see the messages page for the full list and the examples page for patches to copy, f 110;
#X text 30 564 try:  load sync lead and move bfreq: oscillator b sweeps against the synced oscillator a, f 110;
#X text 30 594 try:  raise pmoscb and switch pmfreq on: oscillator b frequency-modulates oscillator a for bells, f 110;
#X text 30 624 try:  raise drift and play a chord: every voice wanders a little differently, f 110;
#X text 30 668 --- common problems ---;
#X text 30 712 no sound: turn dsp on in the engine page and check the volume slider. the synth needs a note: click chord on or play a midi key, f 110;
#X text 30 762 nothing changes after a rebuild: pd keeps the old external in memory so close every patch and restart pd, f 110;
#X text 30 792 a note is stuck: send panic. a missing note off from a midi device is the usual cause, f 110;
#X text 30 822 unknown parameter in the console: names are exact and lowercase so send params to print them all, f 110;
#X text 30 852 a bank file is not found: save and load names are relative to the folder of this patch, f 110;
#X text 30 882 the sliders do not move when you change a preset: the object must be created with the same name as in the boxes. default name is the object name, f 110;
#X text 30 932 clicks or dropouts: raise the audio buffer in the pd audio settings or lower the voice count in the creation argument, f 110;
#X text 30 982 the sound is thin: switch bsaw on and raise mixb because a single oscillator is thin by design, f 110;
#X text 30 1012 sync does nothing: sync needs oscillator b running (mixb up is not required) and bfreq away from the middle, f 110;
#X text 30 1076 --- click a box to open that page ---;
#N canvas 0 50 900 1242 presets 0;
#X text 30 16 presets: factory sounds are stored as plain text and every control above is a message. click a box to load that sound, f 100;
#X text 30 66 --- factory presets ---;
#X msg 30 110 \; prophet5 preset 0;
#X text 250 112 0  warm brass;
#X msg 30 164 \; prophet5 preset 1;
#X text 250 166 1  poly strings;
#X msg 30 218 \; prophet5 preset 2;
#X text 250 220 2  soft pad;
#X msg 30 272 \; prophet5 preset 3;
#X text 250 274 3  sync lead;
#X msg 30 326 \; prophet5 preset 4;
#X text 250 328 4  poly bass;
#X msg 30 380 \; prophet5 preset 5;
#X text 250 382 5  fm bell;
#X msg 30 434 \; prophet5 preset 6;
#X text 250 436 6  pwm keys;
#X msg 460 110 \; prophet5 preset 7;
#X text 680 112 7  pluck;
#X msg 460 164 \; prophet5 preset 8;
#X text 680 166 8  choir;
#X msg 460 218 \; prophet5 preset 9;
#X text 680 220 9  hollow reed;
#X msg 460 272 \; prophet5 preset 10;
#X text 680 274 10  noise wash;
#X msg 460 326 \; prophet5 preset 11;
#X text 680 328 11  detuned saws;
#X msg 460 380 \; prophet5 preset 12;
#X text 680 382 12  zap;
#X msg 460 434 \; prophet5 preset 13;
#X text 680 436 13  soft bell pad;
#X text 30 508 --- now playing ---;
#X symbolatom 30 552 20 0 0 0 - prophet5-name - 0;
#X floatatom 230 552 4 0 0 0 - prophet5-index - 0;
#X text 340 554 name and number (minus one means edited);
#X msg 30 596 \; prophet5 next;
#X msg 190 596 \; prophet5 prev;
#X msg 350 596 \; prophet5 mutate 0.3;
#X text 30 656 next and prev step through the presets and wrap around. mutate varies the current sound by a random amount from 0 to 1, f 100;
#X text 30 706 --- morph between two sounds ---;
#X msg 30 750 \; prophet5 A;
#X msg 166 750 \; prophet5 B;
#X text 302 752 a and b remember the current sound;
#X text 30 812 morph;
#X obj 110 810 hsl 300 18 0 1 0 0 prophet5-morph prophet5-morph-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 854 load one preset and press a then load another and press b then move the morph slider. every parameter blends smoothly between the two, f 100;
#X text 30 904 --- your own user bank ---;
#X msg 30 948 \; prophet5 store mysound;
#X msg 262 948 \; prophet5 save my.bank;
#X msg 486 948 \; prophet5 load my.bank;
#X text 30 1008 store keeps the current sound after the factory presets. save writes the user bank to a text file next to this patch and load adds the sounds from a text file, f 100;
#X text 30 1058 --- presets with stash ---;
#X text 30 1102 every slider in the parameters page sends to prophet5-name and listens on prophet5-name-r so the stash library can store and morph whole scenes: create [stash/bank prophet5] and send it a scan message for a saved copy of the parameters page. this follows the stash naming rules but has not been tested together yet, f 100;
#X restore 30 1120 pd presets;
#X text 30 1154 all sounds and morph, f 22;
#N canvas 0 50 1500 2146 parameters 0;
#X text 30 16 every control here is also a message: set name value with values from 0 to 1. switches take the step number shown under each one, f 120;
