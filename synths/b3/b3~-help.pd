#X text 770 150 drawbar levels 0 to 1: set d8 0.8, f 28;
#X text 30 330 --- percussion ---;
#X text 30 370 percussion  -  set perc;
#X obj 30 402 hradio 18 1 0 2 b3-perc b3-perc-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 30 434 0..1 : off | on, f 34;
#X text 30 488 harmonic  -  set pharm;
#X obj 30 520 hradio 18 1 0 2 b3-pharm b3-pharm-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 30 552 0..1 : 2nd | 3rd, f 34;
#X text 30 606 decay  -  set pdec;
#X obj 30 638 hradio 18 1 0 2 b3-pdec b3-pdec-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 30 670 0..1 : fast | slow, f 34;
#X text 30 724 level  -  set pvol;
#X obj 30 756 hradio 18 1 0 2 b3-pvol b3-pvol-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 30 788 0..1 : soft | normal, f 34;
#X text 350 330 --- vibrato and rotary ---;
#X text 350 370 vibrato  -  set vib;
#X obj 350 402 hradio 18 1 0 7 b3-vib b3-vib-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 350 434 0..6 : off | v1 v2 v3 | c1 c2 c3, f 34;
#X text 350 488 rotary  -  set leslie;
#X obj 350 520 hradio 18 1 0 3 b3-leslie b3-leslie-r empty 0 -8 0 10 -262144 -1 -1 0;
#X text 350 552 0..2 : off | slow | fast, f 34;
#X text 670 330 --- tone ---;
#X text 670 370 key click  -  set click;
#X obj 670 402 hsl 190 18 0 1 0 0 b3-click b3-click-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 670 488 drive  -  set drive;
#X obj 670 520 hsl 190 18 0 1 0 0 b3-drive b3-drive-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 670 606 volume  -  set vol;
#X obj 670 638 hsl 190 18 0 1 0 0 b3-vol b3-vol-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X restore 220 1080 pd parameters;
#X text 220 1114 every control, f 22;
#N canvas 0 50 1300 1516 messages 0;
#X text 30 16 click any box to send it to the synth. the synth receives everything through its name so you can use [s b3] from anywhere in your patch, f 110;
#X msg 30 66 \; b3 note 60 100;
#X text 334 68 play midi note 60 at velocity 100 (velocity 0 is note off);
#X msg 30 120 \; b3 note 60 0;
#X text 334 122 release note 60;
#X msg 30 174 \; b3 bend 0.5;
#X text 334 176 pitch bend from -1 to 1 (size set by bendrange);
#X msg 30 228 \; b3 bendrange 12;
#X text 334 230 bend range in semitones (default 2);
#X msg 30 282 \; b3 mod 0.5;
#X text 334 284 mod wheel from 0 to 1 (more lfo);
#X msg 30 336 \; b3 aftertouch 0.5;
#X text 334 338 channel pressure from 0 to 1 (opens the filter);
#X msg 30 390 \; b3 sustain 1;
#X text 334 392 sustain pedal (1 down and 0 up);
#X msg 30 444 \; b3 panic;
#X text 334 446 silence everything immediately;
#X msg 30 498 \; b3 set drive 0.3;
#X text 334 500 set one parameter by name (see the parameters page);
#X msg 30 552 \; b3 params;
#X text 334 554 print every parameter name to the pd window;
#X msg 30 606 \; b3 preset 3;
#X text 334 608 load preset number 3 (counting from 0);
#X msg 30 660 \; b3 next;
#X text 334 662 next preset (wraps around);
#X msg 30 714 \; b3 prev;
#X text 334 716 previous preset;
#X msg 30 768 \; b3 mutate 0.3;
#X text 334 770 random variation of the current sound from 0 to 1;
#X msg 30 822 \; b3 A;
#X text 334 824 remember the current sound as a;
#X msg 30 876 \; b3 B;
#X text 334 878 remember the current sound as b;
#X msg 30 930 \; b3 morph 0.5;
#X text 334 932 blend between a and b;
#X msg 30 984 \; b3 store mysound;
#X text 334 986 keep the current sound in the user bank after the factory presets;
#X msg 30 1038 \; b3 save my.bank;
#X text 334 1040 write the user bank to a text file next to this patch;
#X msg 30 1092 \; b3 load my.bank;
#X text 334 1094 add the presets from a text file to the user bank;
#X msg 30 1146 \; b3 data 0.5;
#X text 334 1148 data inlet: any number from 0 to 1 (a sensor or a csv column) that drives mapped parameters;
#X msg 30 1200 \; b3 datamap drive 0.3;
#X text 334 1202 map data to a parameter: it moves up to 0.3 either side (a negative amount inverts);
#X msg 30 1254 \; b3 datamap clear;
#X text 334 1256 remove all data mappings (up to four at once);
#X text 30 1322 --- outlets of the object ---;
#X text 30 1366 outlet 1 audio left   outlet 2 audio right   outlet 3 preset name as a symbol   outlet 4 list with preset index and preset count, f 110;
#X text 30 1416 create it as [b3~]  or  [b3~ name]  or  [b3~ name 8]   where name is the prefix used by every box and 8 is the voice count, f 110;
#X restore 410 1080 pd messages;
#X text 410 1114 clickable list, f 22;
#N canvas 0 50 1300 1300 examples 0;
