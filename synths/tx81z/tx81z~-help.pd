#X restore 220 1100 pd parameters;
#X text 220 1134 every control, f 22;
#N canvas 0 50 1300 1056 messages 0;
#X text 30 16 click any box to send it to the synth. the synth receives everything through its name so you can use [s tx81z] from anywhere in your patch, f 110;
#X msg 30 66 \; tx81z note 60 100;
#X text 334 68 play midi note 60 at velocity 100 (velocity 0 is note off);
#X msg 30 100 \; tx81z note 60 0;
#X text 334 102 release note 60;
#X msg 30 134 \; tx81z bend 0.5;
#X text 334 136 pitch bend from -1 to 1 (size set by bendrange);
#X msg 30 168 \; tx81z bendrange 12;
#X text 334 170 bend range in semitones (default 2);
#X msg 30 202 \; tx81z mod 0.5;
#X text 334 204 mod wheel from 0 to 1 (more lfo);
#X msg 30 236 \; tx81z aftertouch 0.5;
#X text 334 238 channel pressure from 0 to 1 (opens the filter);
#X msg 30 270 \; tx81z sustain 1;
#X text 334 272 sustain pedal (1 down and 0 up);
#X msg 30 304 \; tx81z panic;
#X text 334 306 silence everything immediately;
#X msg 30 338 \; tx81z set level2 0.3;
#X text 334 340 set one parameter by name (see the parameters page);
#X msg 30 372 \; tx81z params;
#X text 334 374 print every parameter name to the pd window;
#X msg 30 406 \; tx81z preset 3;
#X text 334 408 load preset number 3 (counting from 0);
#X msg 30 440 \; tx81z next;
#X text 334 442 next preset (wraps around);
#X msg 30 474 \; tx81z prev;
#X text 334 476 previous preset;
#X msg 30 508 \; tx81z mutate 0.3;
#X text 334 510 random variation of the current sound from 0 to 1;
#X msg 30 542 \; tx81z A;
#X text 334 544 remember the current sound as a;
#X msg 30 576 \; tx81z B;
#X text 334 578 remember the current sound as b;
#X msg 30 610 \; tx81z morph 0.5;
#X text 334 612 blend between a and b;
#X msg 30 644 \; tx81z store mysound;
#X text 334 646 keep the current sound in the user bank after the factory presets;
#X msg 30 678 \; tx81z save my.bank;
#X text 334 680 write the user bank to a text file next to this patch;
#X msg 30 712 \; tx81z load my.bank;
#X text 334 714 add the presets from a text file to the user bank;
#X msg 30 746 \; tx81z data 0.5;
#X text 334 748 data inlet: any number from 0 to 1 (a sensor or a csv column) that drives mapped parameters;
#X msg 30 780 \; tx81z datamap level2 0.3;
#X text 334 782 map data to a parameter: it moves up to 0.3 either side (a negative amount inverts);
#X msg 30 814 \; tx81z datamap clear;
#X text 334 816 remove all data mappings (up to four at once);
#X text 30 862 --- outlets of the object ---;
#X text 30 906 outlet 1 audio left   outlet 2 audio right   outlet 3 preset name as a symbol   outlet 4 list with preset index and preset count, f 110;
#X text 30 956 create it as [tx81z~]  or  [tx81z~ name]  or  [tx81z~ name 8]   where name is the prefix used by every box and 8 is the voice count, f 110;
#X restore 410 1100 pd messages;
#X text 410 1134 clickable list, f 22;
