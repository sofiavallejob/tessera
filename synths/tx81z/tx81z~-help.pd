#X msg 30 212 \; tx81z preset 3;
#X text 250 214 3  marimba;
#X msg 30 246 \; tx81z preset 4;
#X text 250 248 4  brass stab;
#X msg 30 280 \; tx81z preset 5;
#X text 250 282 5  slap bass;
#X msg 30 314 \; tx81z preset 6;
#X text 250 316 6  digi strings;
#X msg 30 348 \; tx81z preset 7;
#X text 250 350 7  organ mix;
#X msg 460 110 \; tx81z preset 8;
#X text 680 112 8  clav;
#X msg 460 144 \; tx81z preset 9;
#X text 680 146 9  vibes;
#X msg 460 178 \; tx81z preset 10;
#X text 680 180 10  breath flute;
#X msg 460 212 \; tx81z preset 11;
#X text 680 214 11  pluck harp;
#X msg 460 246 \; tx81z preset 12;
#X text 680 248 12  square lead;
#X msg 460 280 \; tx81z preset 13;
#X text 680 282 13  metal hit;
#X msg 460 314 \; tx81z preset 14;
#X text 680 316 14  warm pad;
#X msg 460 348 \; tx81z preset 15;
#X text 680 350 15  half sine bell;
#X text 30 402 --- now playing ---;
#X symbolatom 30 446 20 0 0 0 - tx81z-name - 0;
#X floatatom 230 446 4 0 0 0 - tx81z-index - 0;
#X text 340 448 name and number (minus one means edited);
#X msg 30 490 \; tx81z next;
#X msg 166 490 \; tx81z prev;
#X msg 302 490 \; tx81z mutate 0.3;
#X text 30 530 next and prev step through the presets and wrap around. mutate varies the current sound by a random amount from 0 to 1, f 100;
#X text 30 580 --- morph between two sounds ---;
#X msg 30 624 \; tx81z A;
#X msg 142 624 \; tx81z B;
#X text 254 626 a and b remember the current sound;
#X text 30 666 morph;
#X obj 110 664 hsl 300 18 0 1 0 0 tx81z-morph tx81z-morph-r empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 708 load one preset and press a then load another and press b then move the morph slider. every parameter blends smoothly between the two, f 100;
#X text 30 758 --- your own user bank ---;
#X msg 30 802 \; tx81z store mysound;
#X msg 238 802 \; tx81z save my.bank;
#X msg 438 802 \; tx81z load my.bank;
#X text 30 842 store keeps the current sound after the factory presets. save writes the user bank to a text file next to this patch and load adds the sounds from a text file, f 100;
#X text 30 892 --- presets with stash ---;
#X text 30 936 every slider in the parameters page sends to tx81z-name and listens on tx81z-name-r so the stash library can store and morph whole scenes: create [stash/bank tx81z] and send it a scan message for a saved copy of the parameters page. this follows the stash naming rules but has not been tested together yet, f 100;
#X restore 30 1100 pd presets;
#X text 30 1134 all sounds and morph, f 22;
#N canvas 0 50 1500 2202 parameters 0;
#X text 30 16 every control here is also a message: set name value with values from 0 to 1. switches take the step number shown under each one, f 120;
