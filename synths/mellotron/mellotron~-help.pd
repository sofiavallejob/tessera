#X obj 650 230 line 0 30;
#X obj 650 270 list prepend morph;
#X obj 650 310 list trim;
#X obj 650 350 s mellotron;
#X text 650 396 store sounds with a and b first (presets page), f 26;
#X text 980 76 4  sweep tone with a ramp;
