#X obj 330 210 tgl 18 0 empty empty empty 17 7 0 10 -262144 -1 -1 0 1;
#X obj 330 250 metro 6000;
#X msg 330 290 0 \, 1 3000 \, 0 3000 3000;
#X obj 330 330 line 0 30;
