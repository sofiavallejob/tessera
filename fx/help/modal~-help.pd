#N canvas 0 50 1040 1040 12;
#X text 30 16 =^..^=   modal~   version 1 (2026)   sofia vallejo budziszewski   iem kug graz austria;
#X text 30 46 modal resonator bank;
#X text 30 86 a bank of up to 32 tuned resonators. the mode ratios come from a material (glass wood bell plate bar string tube bowl) or are learned from a sound. modes can be snapped to a scale, f 110;
#X text 30 146 --- how it was made ---;
#X text 30 190 every mode is a two pole resonator tuned to the root note times a ratio. the gain is normalised so a sine at the mode frequency passes at the mode weight. learn records one second of input and picks the strongest peaks of its averaged spectrum as the new modes, f 110;
#X text 30 270 --- how to use ---;
#X text 30 314 1  open the engine page and switch the sound on or press strike, f 110;
#X text 30 344 2  choose a material and a root note, f 110;
#X text 30 374 3  set scale to pentatonic and snap to 1 to pull every mode onto the scale, f 110;
#X text 30 404 4  send learn and play a sound for one second to take its modes, f 110;
#X text 30 434 everything is a message: see the messages page for the full list and the examples page for patches to copy. every effect has presets and a and b morph and mutate and a data inlet, f 110;
#X text 30 494 try:  a sine at the root excites the first mode strongly. broadband sounds excite all modes, f 110;
#X text 30 524 try:  drive is in db. raise it for quiet inputs, f 110;
#X text 30 554 try:  stretch moves the modes away from or toward harmonic positions, f 110;
#X text 30 598 --- common problems ---;
#X text 30 642 very quiet output: raise drive or mix and strike the bank, f 110;
#X text 30 672 learn found nothing: the input was silent or too quiet. send learn again while a sound plays, f 110;
#X text 30 702 material learned sounds like nothing: learn first, f 110;
#X text 30 732 names: give every instance its own name as the first argument like [tessera/modal~ m1]. the name is also the stash namespace, f 110;
#X text 30 796 --- click a box to open that page ---;
#N canvas 0 50 900 974 presets 0;
#X text 30 16 factory sounds are stored as plain text. click a box to load that sound. every slider in the effect follows, f 100;
#X text 30 66 --- factory presets ---;
#X msg 30 110 \; m1 preset 0;
#X text 240 112 0  default;
#X msg 30 144 \; m1 preset 1;
#X text 240 146 1  glass bowl;
#X msg 30 178 \; m1 preset 2;
#X text 240 180 2  marimba;
#X msg 30 212 \; m1 preset 3;
#X text 240 214 3  temple bell;
#X msg 30 246 \; m1 preset 4;
#X text 240 248 4  steel plate;
#X msg 460 110 \; m1 preset 5;
#X text 670 112 5  chime bar;
#X msg 460 144 \; m1 preset 6;
#X text 670 146 6  pentatonic haze;
#X msg 460 178 \; m1 preset 7;
#X text 670 180 7  organ pipe;
#X msg 460 212 \; m1 preset 8;
#X text 670 214 8  singing bowl;
#X text 30 300 --- now playing ---;
#X symbolatom 30 344 20 0 0 0 - m1-name -;
#X floatatom 230 344 4 0 0 0 - m1-index -;
#X text 340 346 name and number (minus one means edited);
#X msg 30 388 \; m1 next;
#X msg 142 388 \; m1 prev;
#X msg 254 388 \; m1 mutate 0.3;
#X text 30 428 next and prev step through the presets and wrap around. mutate varies the current sound by a random amount from 0 to 1. mutate leaves mix and level alone, f 100;
#X text 30 478 --- morph between two sounds ---;
#X msg 30 522 \; m1 A;
#X msg 118 522 \; m1 B;
#X text 206 524 a and b remember the current sound;
#X text 30 564 morph;
#X obj 110 562 hsl 300 18 0 1 0 0 m1-morph empty empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 606 load one preset and press a then load another and press b then move the morph slider. every continuous parameter blends smoothly. switches change at the middle, f 100;
#X text 30 656 --- your own user bank ---;
#X msg 30 700 \; m1 store mysound;
#X msg 214 700 \; m1 save my.bank;
#X msg 390 700 \; m1 load my.bank;
#X text 30 740 store keeps the current sound after the factory presets. save writes the user bank to a text file next to this patch and load reads such a file, f 100;
#X text 30 790 --- presets with stash ---;
#X text 30 834 every slider of the effect sends to m1-param and listens on m1-param-r. this is the naming scheme of the stash preset library: create [stash/bank m1] and send it a scan message with the name of the patch that holds the effect. it follows the stash rules but has not been tested together yet, f 100;
#X restore 30 840 pd presets;
#X text 30 874 all sounds and morph, f 22;
#N canvas 0 50 1200 814 parameters 0;
#X text 30 16 every parameter is also a message: [name value( in real units or for a switch the option name or number. the controls in the effect panel and these messages do the same, f 120;
#X text 30 66 parameter;
#X text 210 66 values;
#X text 560 66 what it does;
#X text 30 100 root;
#X text 210 100 24 to 96, f 36;
#X text 560 100 midi note of the lowest mode, f 54;
#X text 30 136 material;
#X text 210 136 glass | wood | bell | plate | bar | string | tube | bowl | learned, f 36;
#X text 560 136 mode ratios: glass wood bell plate bar string tube bowl or learned, f 54;
#X text 30 212 modes;
#X text 210 212 1 to 32 whole numbers, f 36;
#X text 560 212 number of resonators, f 54;
#X text 30 248 scale;
#X text 210 248 free | major | minor | pentatonic | whole | dorian | fifths, f 36;
#X text 560 248 scale for snap, f 54;
#X text 30 304 key;
#X text 210 304 c | c# | d | d# | e | f | f# | g | g# | a | a# | b, f 36;
#X text 560 304 root of the scale for snap, f 54;
#X text 30 360 snap;
#X text 210 360 0 to 1, f 36;
#X text 560 360 how far modes are pulled onto the scale, f 54;
#X text 30 396 decay;
#X text 210 396 0.05 to 12 log, f 36;
#X text 560 396 decay time of the lowest mode in seconds, f 54;
#X text 30 432 damp;
#X text 210 432 0 to 1, f 36;
#X text 560 432 higher modes decay faster as this grows, f 54;
#X text 30 468 stretch;
#X text 210 468 -0.4 to 0.4, f 36;
#X text 560 468 moves modes away from (plus) or toward (minus) harmonic positions, f 54;
#X text 30 524 bright;
#X text 210 524 0 to 1, f 36;
#X text 560 524 weight of the higher modes, f 54;
#X text 30 560 spread;
#X text 210 560 0 to 1, f 36;
#X text 560 560 stereo spread of the modes, f 54;
#X text 30 596 drive;
#X text 210 596 -12 to 36, f 36;
#X text 560 596 input gain in db, f 54;
#X text 30 632 mix;
#X text 210 632 0 to 1, f 36;
#X text 560 632 0 is the dry sound and 1 is only the effect, f 54;
#X text 30 668 level;
#X text 210 668 -24 to 12, f 36;
#X text 560 668 output level in db, f 54;
#X text 30 714 any continuous parameter can be driven by data: send datamap name amount and then data 0 to 1. see the messages page, f 120;
#X restore 220 840 pd parameters;
#X text 220 874 every control, f 22;
#N canvas 0 50 1300 792 messages 0;
#X text 30 16 click any box to send it to the effect. the effect listens to its name so you can use [s m1] from anywhere in your patch, f 110;
#X text 30 66 message;
#X text 430 66 what it does;
#X msg 30 100 \; m1 params;
#X text 430 102 prints every parameter and its range in the console, f 76;
#X msg 30 134 \; m1 preset 3;
#X text 430 136 loads preset 3 (or a preset by name: preset glass bowl), f 76;
#X msg 30 168 \; m1 next;
#X text 430 170 next preset (wraps around), f 76;
#X msg 30 202 \; m1 prev;
#X text 430 204 previous preset, f 76;
#X msg 30 236 \; m1 mutate 0.4;
#X text 430 238 random variation of the current sound. 0 is nothing and 1 is a lot, f 76;
#X msg 30 270 \; m1 A;
#X text 430 272 remember the current sound as a, f 76;
#X msg 30 304 \; m1 B;
#X text 430 306 remember the current sound as b, f 76;
#X msg 30 338 \; m1 morph 0.5;
#X text 430 340 blend between a and b from 0 to 1, f 76;
#X msg 30 372 \; m1 data 0.7;
#X text 430 374 data inlet: a value from 0 to 1, f 76;
#X msg 30 406 \; m1 datamap root 0.5;
#X text 430 408 map the data inlet to a continuous parameter. 0.5 means the full range of the parameter at data 0 and 1. amount 0 removes the mapping. up to four mappings, f 76;
#X msg 30 480 \; m1 datamap clear;
#X text 430 482 remove all data mappings, f 76;
#X msg 30 514 \; m1 store mysound;
#X text 430 516 keep the current sound in the user bank, f 76;
#X msg 30 548 \; m1 save my.bank;
#X text 430 550 write the user bank to a text file, f 76;
#X msg 30 582 \; m1 load my.bank;
#X text 430 584 read a user bank, f 76;
#X msg 30 616 \; m1 strike 1;
#X text 430 618 sets all modes ringing at their own weights. the number is the strength, f 76;
#X msg 30 670 \; m1 learn;
#X text 430 672 records one second of the input and takes its strongest peaks as modes. then choose material learned. the outlet reports how many modes were found, f 76;
#X restore 410 840 pd messages;
#X text 410 874 clickable list, f 22;
#N canvas 0 50 1300 1000 examples 0;
#X text 30 16 copy these into your own patch. they all talk to the effect through [s m1] so the engine page must be open with dsp on, f 130;
