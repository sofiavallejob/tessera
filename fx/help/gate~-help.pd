#N canvas 0 50 1040 930 12;
#X text 30 16 =^..^=   gate~   version 1 (2026)   sofia vallejo budziszewski   iem kug graz austria;
#X text 30 46 spectral gate;
#X text 30 86 keeps only the strongest frequency bins of each moment and removes the rest. invert keeps the quiet bins instead, f 110;
#X text 30 146 --- how it was made ---;
#X text 30 190 the same stft engine. every frame is compared with its own loudest bin and bins below the threshold are turned down smoothly with attack and release times, f 110;
#X text 30 250 --- how to use ---;
#X text 30 294 1  open the engine page and switch the sound on (the source has a tone and some noise), f 110;
#X text 30 324 2  raise thresh until only the tone is left, f 110;
#X text 30 354 3  turn invert on to keep what was removed, f 110;
#X text 30 384 everything is a message: see the messages page for the full list and the examples page for patches to copy. every effect has presets and a and b morph and mutate and a data inlet, f 110;
#X text 30 444 try:  thresh is relative to the loudest bin of every moment so it works at any level, f 110;
#X text 30 474 try:  floor at -90 removes the closed bins completely, f 110;
#X text 30 518 --- common problems ---;
#X text 30 562 silence: thresh is too high. lower it, f 110;
#X text 30 592 ringing: raise release or lower floor, f 110;
#X text 30 622 names: give every instance its own name as the first argument like [tessera/gate~ t1]. the name is also the stash namespace, f 110;
#X text 30 686 --- click a box to open that page ---;
#N canvas 0 50 900 906 presets 0;
#X text 30 16 factory sounds are stored as plain text. click a box to load that sound. every slider in the effect follows, f 100;
#X text 30 66 --- factory presets ---;
#X msg 30 110 \; t1 preset 0;
#X text 240 112 0  default;
#X msg 30 144 \; t1 preset 1;
#X text 240 146 1  skeleton;
#X msg 30 178 \; t1 preset 2;
#X text 240 180 2  whisper;
#X msg 460 110 \; t1 preset 3;
#X text 670 112 3  hollow;
#X msg 460 144 \; t1 preset 4;
#X text 670 146 4  slow bloom;
#X msg 460 178 \; t1 preset 5;
#X text 670 180 5  subtle;
#X text 30 232 --- now playing ---;
#X symbolatom 30 276 20 0 0 0 - t1-name -;
#X floatatom 230 276 4 0 0 0 - t1-index -;
#X text 340 278 name and number (minus one means edited);
#X msg 30 320 \; t1 next;
#X msg 142 320 \; t1 prev;
#X msg 254 320 \; t1 mutate 0.3;
#X text 30 360 next and prev step through the presets and wrap around. mutate varies the current sound by a random amount from 0 to 1. mutate leaves mix and level alone, f 100;
#X text 30 410 --- morph between two sounds ---;
#X msg 30 454 \; t1 A;
#X msg 118 454 \; t1 B;
#X text 206 456 a and b remember the current sound;
#X text 30 496 morph;
#X obj 110 494 hsl 300 18 0 1 0 0 t1-morph empty empty -2 -8 0 12 -262144 -1 -1 0 1;
#X text 30 538 load one preset and press a then load another and press b then move the morph slider. every continuous parameter blends smoothly. switches change at the middle, f 100;
#X text 30 588 --- your own user bank ---;
#X msg 30 632 \; t1 store mysound;
#X msg 214 632 \; t1 save my.bank;
#X msg 390 632 \; t1 load my.bank;
#X text 30 672 store keeps the current sound after the factory presets. save writes the user bank to a text file next to this patch and load reads such a file, f 100;
#X text 30 722 --- presets with stash ---;
#X text 30 766 every slider of the effect sends to t1-param and listens on t1-param-r. this is the naming scheme of the stash preset library: create [stash/bank t1] and send it a scan message with the name of the patch that holds the effect. it follows the stash rules but has not been tested together yet, f 100;
#X restore 30 730 pd presets;
#X text 30 764 all sounds and morph, f 22;
#N canvas 0 50 1200 466 parameters 0;
#X text 30 16 every parameter is also a message: [name value( in real units or for a switch the option name or number. the controls in the effect panel and these messages do the same, f 120;
#X text 30 66 parameter;
#X text 210 66 values;
#X text 560 66 what it does;
#X text 30 100 thresh;
#X text 210 100 -80 to 0, f 36;
#X text 560 100 bins quieter than this (db below the loudest bin) are closed, f 54;
#X text 30 156 floor;
#X text 210 156 -90 to 0, f 36;
#X text 560 156 level of closed bins in db, f 54;
#X text 30 192 attack;
#X text 210 192 1 to 500 log, f 36;
#X text 560 192 how fast bins open in ms, f 54;
#X text 30 228 release;
#X text 210 228 1 to 2000 log, f 36;
#X text 560 228 how fast bins close in ms, f 54;
#X text 30 264 invert;
#X text 210 264 off | on, f 36;
#X text 560 264 on keeps the quiet bins and removes the strong ones, f 54;
#X text 30 320 mix;
#X text 210 320 0 to 1, f 36;
#X text 560 320 0 is the dry sound and 1 is only the effect, f 54;
#X text 30 366 any continuous parameter can be driven by data: send datamap name amount and then data 0 to 1. see the messages page, f 120;
#X restore 220 730 pd parameters;
#X text 220 764 every control, f 22;
#N canvas 0 50 1300 766 messages 0;
#X text 30 16 click any box to send it to the effect. the effect listens to its name so you can use [s t1] from anywhere in your patch, f 110;
#X text 30 66 message;
#X text 430 66 what it does;
#X msg 30 100 \; t1 params;
#X text 430 102 prints every parameter and its range in the console, f 76;
#X msg 30 134 \; t1 preset 3;
#X text 430 136 loads preset 3 (or a preset by name: preset skeleton), f 76;
#X msg 30 168 \; t1 next;
#X text 430 170 next preset (wraps around), f 76;
#X msg 30 202 \; t1 prev;
#X text 430 204 previous preset, f 76;
#X msg 30 236 \; t1 mutate 0.4;
#X text 430 238 random variation of the current sound. 0 is nothing and 1 is a lot, f 76;
#X msg 30 270 \; t1 A;
#X text 430 272 remember the current sound as a, f 76;
#X msg 30 304 \; t1 B;
#X text 430 306 remember the current sound as b, f 76;
#X msg 30 338 \; t1 morph 0.5;
#X text 430 340 blend between a and b from 0 to 1, f 76;
#X msg 30 372 \; t1 data 0.7;
#X text 430 374 data inlet: a value from 0 to 1, f 76;
#X msg 30 406 \; t1 datamap thresh 0.5;
#X text 430 408 map the data inlet to a continuous parameter. 0.5 means the full range of the parameter at data 0 and 1. amount 0 removes the mapping. up to four mappings, f 76;
#X msg 30 480 \; t1 datamap clear;
#X text 430 482 remove all data mappings, f 76;
#X msg 30 514 \; t1 store mysound;
#X text 430 516 keep the current sound in the user bank, f 76;
#X msg 30 548 \; t1 save my.bank;
#X text 430 550 write the user bank to a text file, f 76;
#X msg 30 582 \; t1 load my.bank;
#X text 430 584 read a user bank, f 76;
#X msg 30 616 \; t1 size 4096;
#X text 430 618 fft size 256 to 16384 (latency equals the size), f 76;
#X msg 30 650 \; t1 reset;
#X text 430 652 clears the buffers, f 76;
#X msg 30 684 \; t1 latency;
#X text 430 686 prints the delay in the console, f 76;
#X restore 410 730 pd messages;
#X text 410 764 clickable list, f 22;
#N canvas 0 50 1300 1000 examples 0;
#X text 30 16 copy these into your own patch. they all talk to the effect through [s t1] so the engine page must be open with dsp on, f 130;
#X text 30 56 1  walk through the presets;
#X obj 30 90 tgl 18 0 empty empty empty 17 7 0 10 -262144 -1 -1 0 1;
#X obj 30 130 metro 2500;
#X obj 30 170 random 6;
#X obj 30 210 list prepend preset;
#X obj 30 250 list trim;
#X obj 30 290 s t1;
#X text 330 56 2  slow morph between preset 0 and 1;
#X msg 330 90 \; t1 preset 0 \; t1 A \; t1 preset 1 \; t1 B;
#X obj 330 150 tgl 18 0 empty empty empty 17 7 0 10 -262144 -1 -1 0 1;
#X obj 330 190 metro 6000;
#X msg 330 230 0 \, 1 3000 \, 0 3000 3000;
#X obj 330 270 line 0 30;
#X obj 330 310 list prepend morph;
#X obj 330 350 list trim;
#X obj 330 390 s t1;
#X text 740 56 3  sweep thresh with a ramp;
#X obj 740 90 tgl 18 0 empty empty empty 17 7 0 10 -262144 -1 -1 0 1;
#X obj 740 130 metro 4000;
#X msg 740 170 -60 \, -5 2000 \, -60 2000 2000;
#X obj 740 210 line -60 30;
#X obj 740 250 list prepend thresh;
#X obj 740 290 list trim;
#X obj 740 330 s t1;
#X text 30 496 4  data in: a ramp stands in for a sensor or a csv column. click the map box once first;
#X msg 30 530 \; t1 datamap thresh 0.4;
#X obj 30 570 tgl 18 0 empty empty empty 17 7 0 10 -262144 -1 -1 0 1;
#X obj 30 610 metro 4000;
#X msg 30 650 0 \, 1 2000 \, 0 2000 2000;
#X obj 30 690 line 0 30;
#X obj 30 730 list prepend data;
#X obj 30 770 list trim;
#X obj 30 810 s t1;
#X text 330 570 in your own patch send any value from 0 to 1 to [s t1] as: data 0.7. for a csv series scale it to the range 0 to 1 first. [tessera/datamod~] does that for you and its data outlet can be connected straight to the inlet of any tessera effect, f 70;
