#X obj 330 210 tgl 18 0 empty empty empty 17 7 0 10 -262144 -1 -1 0 1;
#X obj 330 250 metro 6000;
#X msg 330 290 0 \, 1 3000 \, 0 3000 3000;
#X obj 330 330 line 0 30;
#X obj 330 370 list prepend morph;
#X obj 330 410 list trim;
#X obj 330 450 s g1;
#X text 740 56 3  sweep scrub with a ramp;
#X obj 740 90 tgl 18 0 empty empty empty 17 7 0 10 -262144 -1 -1 0 1;
#X obj 740 130 metro 4000;
#X msg 740 170 0 \, 0.6 2000 \, 0 2000 2000;
#X obj 740 210 line 0 30;
#X obj 740 250 list prepend scrub;
#X obj 740 290 list trim;
#X obj 740 330 s g1;
#X text 30 556 4  data in: a ramp stands in for a sensor or a csv column. click the map box once first;
#X msg 30 590 \; g1 datamap scrub 0.4;
#X obj 30 650 tgl 18 0 empty empty empty 17 7 0 10 -262144 -1 -1 0 1;
#X obj 30 690 metro 4000;
#X msg 30 730 0 \, 1 2000 \, 0 2000 2000;
#X obj 30 770 line 0 30;
