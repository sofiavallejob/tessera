#N canvas 0 50 1550 900 engine 0;
#X text 30 16 the effect below is the abstraction itself with its panel. its name is d1;
#X msg 30 50 \; pd dsp 1;
#X msg 160 50 \; pd dsp 0;
#X text 300 54 dsp on and off;
#X obj 430 100 tessera/datamod~ d1;
#X text 30 100 the four lanes make an oscillator sing: lane 1 is the pitch and lane 2 is the level, f 40;
#X obj 30 190 *~ 600;
#X obj 30 230 +~ 200;
#X obj 30 270 osc~;
#X obj 30 310 *~;
#X obj 30 350 *~ 0.1;
#X obj 30 440 dac~;
#X obj 130 270 *~ 0.8;
#X text 30 500 lane 3 and lane 4 are free. connect them to any signal input, f 40;
#X obj 1210 100 route data cells;
#X text 1210 64 control outlet: data;
#X floatatom 1210 150 8 0 0 0 - - -;
#X text 1210 200 the second control outlet sends the four lanes as a list or the cells of the automaton, f 36;
